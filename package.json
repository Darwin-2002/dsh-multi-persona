{
  "name": "dsh-multi-persona",
  "version": "1.11.5",
  "type": "module",
  "description": "同窗口多人格：按称呼自动切、可同台接话，人格 = 一个文件夹（persona.json + prompt.md + avatar），每人一副头像。内部路径仍沿用 persona-router 前缀。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent",
    "persona",
    "avatar"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darwin-2002/dsh-multi-persona.git"
  },
  "homepage": "https://github.com/Darwin-2002/dsh-multi-persona#readme",
  "bugs": {
    "url": "https://github.com/Darwin-2002/dsh-multi-persona/issues"
  },
  "formerNames": [
    "dsh-persona-router"
  ]
}
